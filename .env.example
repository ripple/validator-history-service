# ============================================
# Validator History Service Configuration
# ============================================
# Copy this file to .env and fill in your values
# For Docker Compose, DB_HOST will be overridden to 'postgres'

# --------------------------------------------
# Node Environment
# --------------------------------------------
# Options: 'development', 'production', or 'test'
NODE_ENV=production

# --------------------------------------------
# Database Configuration
# --------------------------------------------
# Database client type (only Postgres is supported)
DB_CLIENT=pg

# Database connection info
# Note: For Docker Compose, DB_HOST is automatically set to 'postgres'
DB_HOST=localhost
DB_USER=vhs_user
DB_PASSWORD=vhs_password
DB_DATABASE=validator_history
ACQUIRE_CONNECTION_TIMEOUT=60000

# --------------------------------------------
# Server Configuration
# --------------------------------------------
# Port and address for the API server
# Note: For Docker Compose, these are automatically set
PORT=3000
ADDR=0.0.0.0

# --------------------------------------------
# XRPL Network Configuration
# --------------------------------------------
# Rippled Server with access to manifest command
RIPPLED_RPC_ADMIN=https://xrpl.ws/

# Mainnet entry point for crawler (without https://)
MAINNET_P2P_ENTRY=s1.ripple.com

# Validator lists for mainnet (without https://)
MAINNET_UNL=vl.ripple.com

# --------------------------------------------
# GeoIP Configuration (Optional)
# --------------------------------------------
# Keys for geo-location API
# Sign up at: https://dev.maxmind.com/geoip/geoip2/geolite2/
MAXMIND_USER=
MAXMIND_KEY=
